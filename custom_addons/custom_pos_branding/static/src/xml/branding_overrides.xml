<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="custom_pos_branding.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-centerheader')]" position="replace"/>
    </t>

    <t t-name="custom_pos_branding.LoginScreen" t-inherit="point_of_sale.LoginScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('screen-login-logo')]" position="replace"/>
    </t>

    <t t-name="custom_pos_branding.SaverScreen" t-inherit="point_of_sale.SaverScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-logo')]" position="replace"/>
    </t>

    <t t-name="custom_pos_branding.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//img[hasclass('pos-receipt-logo')]" position="replace"/>
    </t>

    <t t-name="custom_pos_branding.SaleDetailsReport" t-inherit="point_of_sale.SaleDetailsReport" t-inherit-mode="extension">
        <xpath expr="//img[hasclass('pos-receipt-logo')]" position="replace"/>
    </t>

    <t t-name="custom_pos_branding.CustomerDisplay" t-inherit="point_of_sale.CustomerDisplay" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_customer_display_logo')]" position="replace"/>
        <xpath expr="//div[contains(normalize-space(.), 'Powered by')]" position="replace"/>
    </t>
</templates>
